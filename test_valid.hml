// 1. Doctor Registrations
REGISTER DOCTOR DOC101 NAME "Dr. Rajesh Sharma" DEPT "Cardiology" FEE 800.00 ;
REGISTER DOCTOR DOC102 NAME "Dr. Anita Desai" DEPT "Neurology" FEE 950.00 ;
REGISTER DOCTOR DOC103 NAME "Dr. Vikram Patil" DEPT "Orthopedics" FEE 600.00 ;

// 2. Patient Registrations
REGISTER PATIENT PAT201 NAME "Aarav Mehta" AGE 34 GENDER M CONTACT "9876543210" ;
REGISTER PATIENT PAT202 NAME "Pooja Hegde" AGE 28 GENDER F CONTACT "9123456780" ;
REGISTER PATIENT PAT203 NAME "Rohan Gupta" AGE 62 GENDER M CONTACT "9988776655" ;

// 3. Appointment Scheduling
SCHEDULE APPOINTMENT FOR PATIENT PAT201 WITH DOCTOR DOC101 DATE "2026-11-02" TIME "10:30 AM" ;
SCHEDULE APPOINTMENT FOR PATIENT PAT202 WITH DOCTOR DOC102 DATE "2026-11-03" TIME "02:15 PM" ;
SCHEDULE APPOINTMENT FOR PATIENT PAT203 WITH DOCTOR DOC103 DATE "2026-11-04" TIME "11:00 AM" ;

// 4. Medical Record Documentation
ADD RECORD FOR PATIENT PAT201 DIAGNOSIS "Mild Hypertension & Arrhythmia" PRESCRIPTION "Amlodipine 5mg, Metoprolol 25mg" ADMITTED NO ;
ADD RECORD FOR PATIENT PAT202 DIAGNOSIS "Chronic Migraine with Aura" PRESCRIPTION "Sumatriptan 50mg, Magnesium" ADMITTED NO ;
ADD RECORD FOR PATIENT PAT203 DIAGNOSIS "Left Femur Fracture" PRESCRIPTION "Surgical pinning, Tramadol 50mg" ADMITTED YES ;

// 5. Billing and Intermediate Code Generation (TAC)
// For PAT201: Consultation ($800) + Lab ($1200) + Meds ($450) + Room ($0) - 10% Discount + 5% Tax
GENERATE BILL FOR PATIENT PAT201 LAB_CHARGES 1200.00 MEDICINE_CHARGES 450.00 ROOM_CHARGES 0.00 DISCOUNT 10.00% ;

// For PAT203: Consultation ($600) + Lab ($3500) + Meds ($1800) + Room ($5000) - 5% Discount + 5% Tax
GENERATE BILL FOR PATIENT PAT203 LAB_CHARGES 3500.00 MEDICINE_CHARGES 1800.00 ROOM_CHARGES 5000.00 DISCOUNT 5.00% ;

// 6. Inspect Symbol Tables and Query Data
SHOW DOCTORS ;
SHOW PATIENTS ;
SHOW APPOINTMENTS ;
SHOW RECORDS FOR PATIENT PAT201 ;
SHOW RECORDS FOR PATIENT PAT203 ;
SHOW BILL FOR PATIENT PAT201 ;
SHOW BILL FOR PATIENT PAT203 ;
SHOW SUMMARY ;
